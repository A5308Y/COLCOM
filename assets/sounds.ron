        "ui_place": (
            files: ["sounds/ui_place_1.wav"],
            volume: 0.35, pitch: (0.95, 1.05), range: 0.0, max: 3, kind: Interface,
        ),
        "ui_open": (
            files: ["sounds/ui_open_1.wav"],
            volume: 0.3, pitch: (1.0, 1.0), range: 0.0, max: 2, kind: Interface,
        ),
    },
    // Loops that play all the time, faded by the time of day and whether the
    // camera looks underground.
    ambience: (
        day: (file: "sounds/amb_day.wav", volume: 0.35),
        night: (file: "sounds/amb_night.wav", volume: 0.35),
        cave: (file: "sounds/amb_cave.wav", volume: 0.45),
    ),
)
