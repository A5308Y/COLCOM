// Sounds, by the names the game uses for them. `files` (in assets/) are
// picked at random. `volume` 0..1; `pitch`: random speed range, so repeats
// differ; `range`: how far from the camera's focus it can be heard, in cells
// (0 = everywhere, not placed in the world); `max`: how many may play at
// once; `every`: seconds between strokes for sounds repeated while working.
// `kind` decides which volume slider it follows: Effect, Alert or Interface.
//
// The files in assets/sounds/ are generated placeholders
// (`python3 tools/make_sounds.py`). Point entries at other WAV or OGG files
// to replace them; nothing else needs to change.
(
    sounds: {
        // Footsteps walking (frequent, soft) and running in battle (heavier).
        "step_grass": (
            files: ["sounds/step_grass_1.wav", "sounds/step_grass_2.wav", "sounds/step_grass_3.wav", "sounds/step_grass_4.wav"],
            volume: 0.18, pitch: (0.95, 1.12), range: 18.0, max: 6, kind: Effect,
        ),
        "step_stone": (
            files: ["sounds/step_stone_1.wav", "sounds/step_stone_2.wav", "sounds/step_stone_3.wav", "sounds/step_stone_4.wav"],
            volume: 0.18, pitch: (0.95, 1.12), range: 18.0, max: 6, kind: Effect,
        ),
        "step_wood": (
            files: ["sounds/step_wood_1.wav", "sounds/step_wood_2.wav", "sounds/step_wood_3.wav", "sounds/step_wood_4.wav"],
            volume: 0.22, pitch: (0.95, 1.12), range: 18.0, max: 6, kind: Effect,
        ),
        "run_grass": (
            files: ["sounds/step_grass_1.wav", "sounds/step_grass_2.wav", "sounds/step_grass_3.wav", "sounds/step_grass_4.wav"],
            volume: 0.4, pitch: (0.8, 0.95), range: 22.0, max: 8, kind: Effect,
        ),
        "run_stone": (
            files: ["sounds/step_stone_1.wav", "sounds/step_stone_2.wav", "sounds/step_stone_3.wav", "sounds/step_stone_4.wav"],
            volume: 0.4, pitch: (0.8, 0.95), range: 22.0, max: 8, kind: Effect,
        ),
        "run_wood": (
            files: ["sounds/step_wood_1.wav", "sounds/step_wood_2.wav", "sounds/step_wood_3.wav", "sounds/step_wood_4.wav"],
            volume: 0.45, pitch: (0.8, 0.95), range: 22.0, max: 8, kind: Effect,
        ),
        "chop": (
            files: ["sounds/chop_1.wav", "sounds/chop_2.wav", "sounds/chop_3.wav"],
            volume: 0.6, pitch: (0.92, 1.08), range: 35.0, max: 4, every: Some(0.75), kind: Effect,
        ),
        "mine": (
            files: ["sounds/mine_1.wav", "sounds/mine_2.wav", "sounds/mine_3.wav"],
            volume: 0.5, pitch: (0.92, 1.08), range: 35.0, max: 4, every: Some(0.8), kind: Effect,
        ),
        "dig": (
            files: ["sounds/dig_1.wav", "sounds/dig_2.wav"],
            volume: 0.5, pitch: (0.9, 1.1), range: 30.0, max: 4, every: Some(0.8), kind: Effect,
        ),
        "hammer": (
            files: ["sounds/hammer_1.wav", "sounds/hammer_2.wav", "sounds/hammer_3.wav"],
            volume: 0.5, pitch: (0.92, 1.08), range: 35.0, max: 4, every: Some(0.6), kind: Effect,
        ),
        "anvil": (
            files: ["sounds/anvil_1.wav", "sounds/anvil_2.wav"],
            volume: 0.45, pitch: (0.95, 1.05), range: 40.0, max: 3, every: Some(0.9), kind: Effect,
