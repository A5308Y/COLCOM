// Sounds, by the names the game uses for them. `files` (in assets/) are
// picked at random. `volume` 0..1; `pitch`: random speed range, so repeats
// differ; `range`: how far from the camera's focus it can be heard, in cells
// (0 = everywhere, not placed in the world); `max`: how many may play at
// once; `every`: seconds between strokes for sounds repeated while working.
// `kind` decides which volume slider it follows: Effect, Alert or Interface.
//
// Files in assets/sounds/kenney/ are from Kenney's Impact Sounds, RPG Audio
// and UI Audio packs (CC0); the rest of assets/sounds/ are generated
// placeholders (`python3 tools/make_sounds.py`) still waiting for real
// sounds. Point entries at other WAV, OGG or MP3 files to replace them;
// nothing else needs to change.
(
    sounds: {
        // Footsteps walking (frequent, soft) and running in battle (heavier).
        "step_grass": (
            files: ["sounds/kenney/footstep_grass_000.ogg", "sounds/kenney/footstep_grass_001.ogg", "sounds/kenney/footstep_grass_002.ogg", "sounds/kenney/footstep_grass_003.ogg", "sounds/kenney/footstep_grass_004.ogg"],
            volume: 0.18, pitch: (0.95, 1.12), range: 18.0, max: 6, kind: Effect,
        ),
        "step_stone": (
            files: ["sounds/kenney/footstep_concrete_000.ogg", "sounds/kenney/footstep_concrete_001.ogg", "sounds/kenney/footstep_concrete_002.ogg", "sounds/kenney/footstep_concrete_003.ogg", "sounds/kenney/footstep_concrete_004.ogg"],
