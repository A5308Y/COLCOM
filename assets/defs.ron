                        (shape: Sphere, color: "leaf_mid", at: (0.17, 0.85, -0.1), size: (0.56, 0.56, 0.56)),
                        (shape: Sphere, color: "leaf_mid", at: (0.0, 1.15, 0.0), size: (0.62, 0.62, 0.62)),
                        (shape: Sphere, color: "leaf_mid", at: (0.05, 0.82, 0.18), size: (0.5, 0.5, 0.5)),
