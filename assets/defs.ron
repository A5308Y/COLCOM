    // What the colonists land with, dropped in their stockpile.
    start_items: [("wood", 80), ("planks", 30), ("meal", 20), ("raw_food", 20), ("medicine", 8)],
    // The first colonists land armed with these, one each in turn; wanderers
    // who join later bring one of them at random.
    start_weapons: ["rifle", "pistol", "knife"],
    // Raiders carry one of these (relative chances).
    // How raiders come equipped, by the colony's threat (`World::threat`: days
    // plus wealth, scaled by the raid size setting). Weapons by relative
    // chance; apparel, sidearms, belt items (kind, count) and cyberware each
    // by their chance. Personal shields only go to melee raiders.
    raider_tiers: [
        (name: "Scavengers", threat: 0.0,
            weapons: [("pistol", 2.0), ("club", 1.0), ("knife", 1.0)],
            apparel: [("clothes", 0.5)]),
        (name: "Gangers", threat: 5.0,
            weapons: [("pistol", 2.0), ("rifle", 2.0), ("club", 1.0), ("knife", 1.0)],
            apparel: [("clothes", 0.8), ("cargo_trousers", 0.5), ("steel_helmet", 0.2)],
            sidearms: [("knife", 0.3)]),
