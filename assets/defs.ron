        (id: "make_optical", name: "Make optical components", bench: "electronics_bench", work: Crafting, skill: Crafting, time: 10.0,
            ingredients: [("silicon", 3), ("copper", 1)], products: [("optical_components", 1)]),
        // Gear.
        (id: "make_knife", name: "Make knife", bench: "smithy", work: Crafting, skill: Crafting, time: 6.0,
