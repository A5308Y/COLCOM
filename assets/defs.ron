                (from: 1.0, variants: [[
                    (shape: Cylinder, color: "trunk", at: (0.0, 0.3, 0.0), size: (0.1, 0.6, 0.1)),
                    (shape: Sphere, color: "leaf", at: (0.0, 0.7, 0.0), size: (0.6, 0.45, 0.6)),
                    (shape: Cylinder, color: "latex", at: (0.06, 0.18, 0.06), size: (0.08, 0.08, 0.08)),
                ]]),
            ],
        ),
    ],

    // Themed rooms. An enclosed, roofed room that has everything in `needs`
    // is that kind of room: each need is one of `things` (buildables), at
    // least `min` of them and at most `max` if given. Doors and windows count
    // for the rooms they border. A room can't be a kind while it has a bed or
    // workbench that kind doesn't ask for. The first kind that fits wins.
    // `floor` tints the room's floor (sRGB); `checker` lays it out in tiles.
    // `effects` (all optional): `rest` multiplies rest gained in its beds,
    // `thought` is what sleepers think of it (text, mood), `work` and `learn`
    // multiply work speed and skill learned at its workbenches, and `extra`
    // is the chance of one more of each product when a recipe is done there.
    // `heal` multiplies how fast patients in its beds heal, `tend` adds to
    // the quality of tending them, `surgery` to the chance operations go well.
    // Rooms with any of these are for the sick: patients look for their beds first.
    // `wallpaper`: the inside of its walls, a `pattern` (Plain, Stripes, Checks,
    // Dots, Tiles, Bricks, Planks or Diamonds) in a `base` and an `accent` colour.
    rooms: [
        (id: "hospital", name: "Hospital", floor: (0.72, 0.84, 0.86), checker: true, about: "Where the sick and wounded get better.",
            needs: [
                (things: ["bed"], min: 1),
                (things: ["medical_cabinet"], min: 1),
                (things: ["window"], min: 2),
                (things: ["lamp"], min: 1),
            ],
            effects: (heal: 1.4, tend: 0.1),
            wallpaper: Some((pattern: Stripes, base: (0.78, 0.9, 0.86), accent: (0.96, 0.98, 0.97))),
        ),
        (id: "surgery", name: "Surgery room", floor: (0.86, 0.9, 0.92), checker: true, about: "Operations: fitting prosthetic limbs.",
            needs: [
                (things: ["operating_table"], min: 1),
                (things: ["medical_cabinet"], min: 1),
                (things: ["lamp"], min: 1),
            ],
            effects: (tend: 0.2, surgery: 0.25),
            wallpaper: Some((pattern: Tiles, base: (0.95, 0.97, 0.98), accent: (0.62, 0.72, 0.8))),
        ),
        (id: "bedroom", name: "Bedroom", floor: (0.62, 0.36, 0.34), about: "A room of one's own.",
            needs: [
                (things: ["bed"], min: 1, max: Some(1)),
                (things: ["window"], min: 1),
                (things: ["door", "stone_door"], min: 1),
                (things: ["dresser"], min: 1),
            ],
            effects: (rest: 1.25, thought: Some(("Slept in a bedroom of their own", 4.0))),
            wallpaper: Some((pattern: Dots, base: (0.78, 0.6, 0.62), accent: (0.95, 0.88, 0.8))),
        ),
        (id: "barracks", name: "Barracks", floor: (0.5, 0.52, 0.38), about: "Beds for many, and a table to sit at.",
            needs: [
                (things: ["bed"], min: 1),
                (things: ["table"], min: 1),
                (things: ["chair"], min: 3),
                (things: ["window"], min: 2),
            ],
            effects: (rest: 1.1, thought: Some(("Slept in the barracks with friends", 2.0))),
            wallpaper: Some((pattern: Stripes, base: (0.56, 0.6, 0.43), accent: (0.4, 0.44, 0.3))),
        ),
        (id: "kitchen", name: "Kitchen", floor: (0.86, 0.82, 0.7), checker: true, about: "Where meals are cooked and stored.",
            needs: [
                (things: ["stove"], min: 1),
                (things: ["window"], min: 1),
                (things: ["shelf"], min: 2),
                (things: ["chair"], min: 1),
                (things: ["table"], min: 1),
            ],
            effects: (work: 1.25, extra: 0.15),
            wallpaper: Some((pattern: Checks, base: (0.95, 0.92, 0.82), accent: (0.45, 0.6, 0.78))),
        ),
        (id: "smithy", name: "Smithy", floor: (0.5, 0.48, 0.47), checker: true, about: "Hot work: smelting and forging.",
            needs: [
                (things: ["smithy"], min: 1),
                (things: ["smelter"], min: 1),
                (things: ["window"], min: 2),
            ],
            effects: (work: 1.3, extra: 0.1),
            wallpaper: Some((pattern: Bricks, base: (0.55, 0.3, 0.24), accent: (0.42, 0.4, 0.38))),
        ),
        (id: "recreation", name: "Recreation room", floor: (0.42, 0.5, 0.36), about: "Games and books: fun comes faster.",
            needs: [
                (things: ["chess_table", "bookshelf", "dartboard"], min: 2),
            ],
            effects: (fun: 1.4),
            wallpaper: Some((pattern: Diamonds, base: (0.5, 0.62, 0.46), accent: (0.86, 0.76, 0.44))),
        ),
        (id: "workshop", name: "Workshop", floor: (0.5, 0.36, 0.22), about: "Sawing, cutting stone and crafting.",
            needs: [
                (things: ["sawbench", "stonecutter", "crafting_bench", "machinist_bench", "refinery", "chemistry_lab",
                    "electronics_bench", "fabricator", "salvage_bench"], min: 1),
                (things: ["table"], min: 1),
            ],
            effects: (work: 1.2, learn: 1.5),
            wallpaper: Some((pattern: Planks, base: (0.66, 0.48, 0.3), accent: (0.44, 0.31, 0.19))),
        ),
    ],

    // Made at workbenches from `ingredients` (delivered by haulers) into
    // `products` (dropped beside the bench), by colonists doing `work`.
    // `sound`: heard while working (names from assets/sounds.ron).
    recipes: [
        (id: "cook_meal", name: "Cook simple meal", bench: "stove", work: Cooking, skill: Cooking, time: 5.0,
            ingredients: [("raw_food", 2)], products: [("meal", 1)], sound: Some("sizzle")),
        (id: "saw_planks", name: "Saw planks", bench: "sawbench", work: Crafting, skill: Crafting, time: 4.0,
            ingredients: [("wood", 5)], products: [("planks", 5)], sound: Some("saw")),
        (id: "cut_blocks", name: "Cut stone blocks", bench: "stonecutter", work: Crafting, skill: Crafting, time: 5.0,
            ingredients: [("stone", 4)], products: [("stone_blocks", 4)], sound: Some("chisel")),
        (id: "smelt_steel", name: "Smelt steel", bench: "smelter", work: Crafting, skill: Crafting, time: 6.0,
            ingredients: [("iron_ore", 4)], products: [("steel", 3)], sound: Some("furnace")),
        (id: "smelt_copper", name: "Smelt copper", bench: "smelter", work: Crafting, skill: Crafting, time: 6.0,
            ingredients: [("copper_ore", 4)], products: [("copper", 3)], sound: Some("furnace")),
        (id: "refine_silicon", name: "Refine silicon", bench: "refinery", work: Crafting, skill: Crafting, time: 8.0,
            ingredients: [("stone", 5)], products: [("silicon", 2)], sound: Some("furnace")),
        (id: "make_rubber", name: "Make rubber", bench: "refinery", work: Crafting, skill: Crafting, time: 6.0,
            ingredients: [("latex", 4)], products: [("rubber", 3)], sound: Some("sizzle")),
        // Components: one recipe each (see their `about`).
        (id: "make_structural", name: "Make structural components", bench: "smithy", work: Crafting, skill: Crafting, time: 8.0,
            ingredients: [("steel", 5)], products: [("structural_components", 2)], sound: Some("anvil")),
        (id: "make_textile", name: "Make textile components", bench: "crafting_bench", work: Crafting, skill: Crafting, time: 7.0,
            ingredients: [("cloth", 3), ("cotton", 2)], products: [("textile_components", 2)]),
        (id: "make_mechanical", name: "Make mechanical components", bench: "machinist_bench", work: Crafting, skill: Crafting, time: 9.0,
            ingredients: [("steel", 4), ("copper", 1)], products: [("mechanical_components", 2)], sound: Some("anvil")),
        (id: "make_chemical", name: "Make chemical components", bench: "chemistry_lab", work: Crafting, skill: Crafting, time: 9.0,
            ingredients: [("copper", 1), ("silicon", 1), ("wood", 2), ("stone", 2)], products: [("chemical_components", 2)], sound: Some("sizzle")),
