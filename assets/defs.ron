            look: Parts([
                (shape: Cube, color: "wood_light", at: (-0.375, 0.125, 0.0), size: (0.25, 0.25, 0.9)),
                (shape: Cube, color: "wood_light", at: (-0.125, 0.25, 0.0), size: (0.25, 0.5, 0.9)),
