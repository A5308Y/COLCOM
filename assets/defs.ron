                        (shape: Cone, color: "pine", at: (0.0, 0.775, 0.0), size: (0.95, 0.75, 0.95)),
                        (shape: Cone, color: "pine", at: (0.0, 1.075, 0.0), size: (0.75, 0.65, 0.75)),
                        (shape: Cone, color: "pine", at: (0.0, 1.325, 0.0), size: (0.5, 0.55, 0.5)),
                    ],
                    [
                        (shape: Cylinder, color: "trunk", at: (0.0, 0.35, 0.0), size: (0.16, 0.7, 0.16)),
                        (shape: Cone, color: "pine_light", at: (0.0, 0.775, 0.0), size: (0.95, 0.75, 0.95)),
                        (shape: Cone, color: "pine_light", at: (0.0, 1.075, 0.0), size: (0.75, 0.65, 0.75)),
