        (
            id: "lamp",
            name: "Lamp",
            key: Some("B"),
            cost: ("wood", 3),
            work_time: 2.0,
            passable: false,
            light: Some((color: (1.0, 0.82, 0.6), intensity: 400000.0, range: 10.0, at: (0.0, 0.86, 0.0))),
            look: Parts([
                (shape: Cylinder, color: "wood", at: (0.0, 0.03, 0.0), size: (0.3, 0.06, 0.3)),
                (shape: Cylinder, color: "wood", at: (0.0, 0.42, 0.0), size: (0.06, 0.8, 0.06)),
                (shape: Sphere, color: "lamp_glow", at: (0.0, 0.86, 0.0), size: (0.22, 0.22, 0.22)),
            ]),
        ),
    ],

    // Plants grow in open cells on soil. `growth` runs from 0 to 1 over
    // `grow_time` seconds of daylight; wild plants appear fully grown.
    // `sow`: planted in grow zones. `wild`: share of open soil covered when the
    // map is made, and relative chance of being the one that regrows.
    // `harvest`: work that removes the plant and drops its yield once grown,
    // on cells designated `desig` (or automatically if there is none).
    // Looks: `stages` by growth, each with variants picked at random per cell,
    // scaled by a random factor in `scale`.
    plants: [
        (
            id: "tree",
            name: "Tree",
            passable: false,
            wild: Some((density: 0.11, regrow: 0.6)),
            harvest: (desig: Some(Chop), work: PlantCutting, skill: Plants, time: 3.0, yields: ("wood", 10), verb: "chopping"),
            scale: (0.85, 1.2),
            stages: [
                (from: 0.0, variants: [
                    [
                        (shape: Cylinder, color: "trunk", at: (0.0, 0.35, 0.0), size: (0.16, 0.7, 0.16)),
                        (shape: Sphere, color: "leaf", at: (-0.16, 0.9, 0.05), size: (0.62, 0.62, 0.62)),
